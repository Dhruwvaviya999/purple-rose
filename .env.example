# Purple Rose — environment template
#
# Copy to `.env.local` for local development:
#   cp .env.example .env.local
#
# `.env.local` is git-ignored. Nothing in this file is a real credential.
# Next.js loads `.env.local` for the application; the Prisma CLI loads the same
# file through `prisma7.config.ts`, so there is one place to set the database.

# ---------------------------------------------------------------------------
# Public (exposed to the browser — never put a secret behind NEXT_PUBLIC_*)
# ---------------------------------------------------------------------------

# Canonical origin. Used for metadataBase, absolute URLs and robots rules.
# Optional locally; set it per environment on the host.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Database — required (PostgreSQL on Neon)
# ---------------------------------------------------------------------------

# Connection string used by the application at runtime.
# On Neon use the POOLED endpoint: its host contains "-pooler".
#   postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require
DATABASE_URL="your-neon-pooled-connection-string"

# Optional. Connection string used only by the Prisma CLI for schema changes.
# On Neon use the DIRECT endpoint, the same host without "-pooler". Migrations
# hold long sessions and run DDL, which a transaction pooler cannot carry.
# Leave unset when your database has a single endpoint; Prisma then falls back
# to DATABASE_URL.
# DIRECT_URL="your-neon-direct-connection-string"

# ---------------------------------------------------------------------------
# Authentication — required
# ---------------------------------------------------------------------------

# Key used to hash one-time codes and to hash request addresses for rate
# limiting. At least 32 characters. Changing it invalidates every code that is
# currently in flight, which is harmless: users simply request a new one.
# Generate one with:  openssl rand -base64 32
AUTH_SECRET="generate-me-openssl-rand-base64-32"

# ---------------------------------------------------------------------------
# Authentication — optional, all have safe defaults
# ---------------------------------------------------------------------------

# How codes are delivered. "console" writes the code to the server log and is
# the only implemented transport. It refuses to run when NODE_ENV=production.
# AUTH_OTP_TRANSPORT="console"

# Region assumed when someone types a number with no country code.
# AUTH_DEFAULT_COUNTRY="IN"

# Code lifetime in seconds (default 300, i.e. 5 minutes).
# AUTH_OTP_TTL_SECONDS="300"

# Wrong guesses allowed per code before it is burned (default 5).
# AUTH_OTP_MAX_ATTEMPTS="5"

# Seconds a user must wait before asking for another code (default 60).
# AUTH_OTP_RESEND_COOLDOWN_SECONDS="60"

# Codes allowed per hour, per phone number (default 5) and per address
# (default 20).
# AUTH_OTP_MAX_PER_PHONE_PER_HOUR="5"
# AUTH_OTP_MAX_PER_IP_PER_HOUR="20"

# How long a signed-in session lasts, in days (default 30).
# AUTH_SESSION_TTL_DAYS="30"

# ---------------------------------------------------------------------------
# Seed (optional)
# ---------------------------------------------------------------------------

# Phone number to promote to ADMIN when `pnpm db:seed` runs. This is the only
# sanctioned way to create an administrator: no request, form or URL can grant
# the role. Unset by default, and the seed skips the step rather than invent a
# number. Any format is accepted; it is normalised the same way sign-in does.
# SEED_ADMIN_PHONE_NUMBER="+919876543210"

# ---------------------------------------------------------------------------
# Server-only — not read by the application yet.
# Each group is activated in the phase that introduces it. Leave the lines
# commented out until then, so a missing value never looks like a bug.
# ---------------------------------------------------------------------------

# SMS delivery, replacing the console transport above.
# SMS_PROVIDER_API_KEY=
# SMS_PROVIDER_SENDER_ID=

# Media storage for product imagery.
# IMAGE_STORAGE_URL=
# IMAGE_STORAGE_TOKEN=

# Transactional email.
# EMAIL_PROVIDER_API_KEY=
# EMAIL_FROM_ADDRESS=

# Payments.
# PAYMENT_PROVIDER_KEY_ID=
# PAYMENT_PROVIDER_KEY_SECRET=
# PAYMENT_WEBHOOK_SECRET=
