# Purple Rose — environment template
#
# Copy to `.env.local` for local development:
#   cp .env.example .env.local
#
# `.env.local` is git-ignored. Nothing in this file is a real credential.
# Next.js loads `.env.local` for the application; the Prisma CLI loads the same
# file through `prisma7.config.ts`, so there is one place to set the database.

# ---------------------------------------------------------------------------
# Public (exposed to the browser — never put a secret behind NEXT_PUBLIC_*)
# ---------------------------------------------------------------------------

# Canonical origin. Used for metadataBase, absolute URLs and robots rules.
# Optional locally; set it per environment on the host.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Database — required (PostgreSQL on Neon)
# ---------------------------------------------------------------------------

# Connection string used by the application at runtime.
# On Neon use the POOLED endpoint: its host contains "-pooler".
#   postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require
DATABASE_URL="your-neon-pooled-connection-string"

# Optional. Connection string used only by the Prisma CLI for schema changes.
# On Neon use the DIRECT endpoint, the same host without "-pooler". Migrations
# hold long sessions and run DDL, which a transaction pooler cannot carry.
# Leave unset when your database has a single endpoint; Prisma then falls back
# to DATABASE_URL.
# DIRECT_URL="your-neon-direct-connection-string"

# ---------------------------------------------------------------------------
# Seed (optional)
# ---------------------------------------------------------------------------

# E.164 phone number to promote to ADMIN when `pnpm db:seed` runs.
# Unset by default: the seed skips the admin step rather than invent a number.
# SEED_ADMIN_PHONE_NUMBER="+919876543210"

# ---------------------------------------------------------------------------
# Server-only — not read by the application yet.
# Each group is activated in the phase that introduces it. Leave the lines
# commented out until then, so a missing value never looks like a bug.
# ---------------------------------------------------------------------------

# Authentication (phone number + one-time code).
# AUTH_SECRET=
# OTP delivery provider.
# SMS_PROVIDER_API_KEY=
# SMS_PROVIDER_SENDER_ID=

# Media storage for product imagery.
# IMAGE_STORAGE_URL=
# IMAGE_STORAGE_TOKEN=

# Transactional email.
# EMAIL_PROVIDER_API_KEY=
# EMAIL_FROM_ADDRESS=

# Payments.
# PAYMENT_PROVIDER_KEY_ID=
# PAYMENT_PROVIDER_KEY_SECRET=
# PAYMENT_WEBHOOK_SECRET=
